[Unit]
Description=Finances : sauvegarde restic de la base (copie en mémoire, chiffrée)
Documentation=file:///srv/finances/docs/exploitation.md
Wants=network-online.target
After=network-online.target finances-secrets.service

[Service]
Type=oneshot
User=finances
Group=finances
Environment=FINANCES_DB=/srv/finances/data/finances.db
Environment=FINANCES_BACKUP_TMP=/run/finances-backup
Environment=RESTIC_CACHE_DIR=/var/cache/finances-restic
ExecStart=/srv/finances/deploy/backup.sh
# Répertoire de travail en mémoire, créé et vidé à chaque exécution.
RuntimeDirectory=finances-backup
RuntimeDirectoryMode=0700
CacheDirectory=finances-restic
# Durcissement
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/finances/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=512M
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=10min
